# Server-side only. Never expose these with a NEXT_PUBLIC_ prefix.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional rate limits (per server instance). Defaults shown.
# AI coach requests per visitor per hour, and for everyone per day.
AI_FEEDBACK_PER_HOUR=20
AI_FEEDBACK_PER_DAY=500
# Any Server Action, per visitor per minute.
ACTION_LIMIT_PER_MINUTE=600
